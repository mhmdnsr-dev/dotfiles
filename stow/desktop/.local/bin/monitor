#!/usr/bin/env bash
# Control both external monitors over DDC/CI (ddcutil): brightness, contrast, color.
#
#   monitor status              show current values of both monitors
#   monitor save [name]         save current values (default name: "saved")
#   monitor load [name]         restore saved values
#   monitor try 1|2|3|4         apply a candidate setup to compare by eye (see below)
#   monitor up|down [step]      brightness of both monitors +/- step (default 10)
#   monitor day|night           apply your chosen day / night setup
#
# Values are DDC VCP codes: 10 brightness, 12 contrast, 14 color preset, 16/18/1A R/G/B gain.
# Saved setups live in ~/.config/monitor/<name>.conf (plain "display code value" lines).
#
# No published colorimeter measurements exist for these models, so the "try" setups are
# starting points built from each monitor's own factory modes. Pick by eye.
set -euo pipefail

# Monitors by model (not serial). Order: 1 = Samsung U28E850 (TN, 4K), 2 = Fujitsu B24W-7 (IPS).
MON1=(--model U28E850)
MON2=(--model "B24W-7 LED")
DIR=${XDG_CONFIG_HOME:-$HOME/.config}/monitor
CODES=(10 12 14 16 18 1A)
DDC=(ddcutil --noverify --sleep-multiplier 0.5)

ddc() { local d=$1; shift; if [ "$d" = 1 ]; then "${DDC[@]}" "${MON1[@]}" "$@"; else "${DDC[@]}" "${MON2[@]}" "$@"; fi; }
# --terse: "VCP 10 C 68 100" (continuous: value is field 4), "VCP 14 SNC x05" or
# "VCP 14 CNC x00 x0b x00 x05" (non-continuous: value is the last byte, SL).
get() { ddc "$1" getvcp "$2" --terse | awk '{v=($3=="C") ? $4 : $NF; sub(/^x/, "0x", v); print v}'; }

# apply <display> code value [code value ...]; pass the color preset (14) first, since
# changing the preset can reset the gains.
apply() {
  local d=$1; shift
  while [ $# -gt 0 ]; do ddc "$d" setvcp "$1" "$2" >/dev/null; shift 2; done
}

status() {
  for d in 1 2; do
    printf 'Display %s %-12s ' "$d" "$( [ $d = 1 ] && echo '(Samsung)' || echo '(Fujitsu)')"
    for c in "${CODES[@]}"; do printf '%s=%s ' "$c" "$(get "$d" "$c")"; done; echo
  done
}

save() {
  mkdir -p "$DIR"; local f=$DIR/${1:-saved}.conf
  { for d in 1 2; do for c in "${CODES[@]}"; do echo "$d $c $(get "$d" "$c")"; done; done; } > "$f"
  echo "saved to $f"
}

load() {
  local f=$DIR/${1:-saved}.conf
  [ -f "$f" ] || { echo "no saved setup: $f" >&2; exit 1; }
  # Preset (14) first. RGB gains only apply to the User presets (0x0b, 0x0c): writing them
  # under a factory preset makes some monitors (Fujitsu) silently switch to User mode.
  for d in 1 2; do
    (
      preset=$(awk -v d="$d" '$1==d && $2=="14" {print $3}' "$f")
      [ -n "$preset" ] && { apply "$d" 14 "$preset" || echo "display $d: preset $preset not settable over DDC" >&2; }
      awk -v d="$d" -v p="$preset" '$1==d && $2!="14" && ($2=="10" || $2=="12" || p=="0x0b" || p=="0x0c") {print $2, $3}' "$f" |
        while read -r c v; do apply "$d" "$c" "$v"; done
    ) &
  done; wait
  echo "loaded $f"
}

try() {
  case ${1:-} in
    1) echo "1) Factory defaults: each monitor's own color + brightness/contrast defaults"
       ddc 1 setvcp 08 1 >/dev/null & ddc 2 setvcp 08 1 >/dev/null & wait
       ddc 1 setvcp 05 1 >/dev/null & ddc 2 setvcp 05 1 >/dev/null & wait ;;
    2) echo "2) Accurate: Samsung 6500K, Fujitsu sRGB, factory-like contrast, medium brightness"
       apply 1 14 0x05 10 55 12 75 & apply 2 14 0x01 10 70 12 50 & wait ;;
    3) echo "3) Comfort: neutral-warm whites (blue/green trimmed), medium brightness"
       apply 1 14 0x0b 16 50 18 48 1A 44 10 50 12 75 &
       apply 2 14 0x0b 16 100 18 96 1A 88 10 55 12 50 & wait ;;
    4) echo "4) Night: low brightness, warm whites"
       apply 1 14 0x0b 16 50 18 44 1A 34 10 25 12 70 &
       apply 2 14 0x0b 16 100 18 88 1A 70 10 25 12 50 & wait ;;
    *) echo "usage: monitor try 1|2|3|4   (1 factory, 2 accurate, 3 comfort, 4 night)" >&2; exit 2 ;;
  esac
  status
}

bright() {
  local step=${2:-10} sign=+; [ "$1" = down ] && sign=-
  ddc 1 setvcp 10 "$sign" "$step" >/dev/null & ddc 2 setvcp 10 "$sign" "$step" >/dev/null & wait
}

case ${1:-status} in
  status) status ;;
  save)   save "${2:-}" ;;
  load)   load "${2:-}" ;;
  try)    try "${2:-}" ;;
  up|down) bright "$1" "${2:-}" ;;
  day|night) load "$1" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
