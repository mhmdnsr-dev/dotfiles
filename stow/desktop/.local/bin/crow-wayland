#!/usr/bin/env bash
# Bridge GNOME custom shortcuts to Crow Translate 2.x over D-Bus.
# Wayland only. Screen-area OCR is done outside Crow (GNOME screenshot portal
# + tesseract), then the text is handed to Crow as the primary selection.
#
# Usage: crow-wayland start|translate|speak|speak-translation|stop|show|ocr-translate|ocr-recognize

set -u

DEST=io.crow_translate.CrowTranslate
OBJ=/io/crow_translate/CrowTranslate/MainWindow
OCR_LANGS=${CROW_OCR_LANGS:-eng}
TESSDATA=${CROW_TESSDATA:-$HOME/.config/crow-translate}
# Fall back to the system tesseract data when Crow has not downloaded its own.
[ -f "$TESSDATA/${OCR_LANGS%%+*}.traineddata" ] || TESSDATA=/usr/share/tesseract-ocr/5/tessdata

notify() { notify-send -a "Crow Translate" -i crow-translate "Crow Translate" "$1"; }

crow_running() {
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner "$DEST" 2>/dev/null | grep -q true
}

# Crow 2.x reads the primary selection natively on Wayland.
ensure_crow() {
    crow_running && return 0
    QT_QPA_PLATFORM=wayland setsid crow >/dev/null 2>&1 </dev/null &
    for _ in $(seq 40); do
        crow_running && sleep 0.5 && return 0
        sleep 0.25
    done
    notify "Crow Translate did not start."
    return 1
}

call() {
    gdbus call --session --dest "$DEST" --object-path "$OBJ" \
        --method "$DEST.MainWindow.$1" >/dev/null
}

# GNOME refuses Crow's own focus request (no activation token), so ask the local
# focus-allowlist@local Shell extension to raise Crow's newest window instead.
# Raise exactly once: retry only while Crow's window isn't visible yet (Activate returns
# false). A second raise after success would yank Crow back if the user already
# clicked another window (seen as a hide/show flash).
raise_crow() {
    (
        sleep 0.2
        for _ in $(seq 10); do
            gdbus call --session --dest org.gnome.Shell --object-path /local/FocusAllowlist \
                --method local.FocusAllowlist.Activate crow 2>/dev/null | grep -q true && exit 0
            sleep 0.15
        done
    ) &
}

# Interactive GNOME screenshot via xdg-desktop-portal; prints the saved file path.
portal_screenshot() {
    python3 - <<'PY'
import random, sys
from gi.repository import Gio, GLib

bus = Gio.bus_get_sync(Gio.BusType.SESSION)
token = "crow%d" % random.randint(0, 1 << 30)
sender = bus.get_unique_name()[1:].replace(".", "_")
path = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
loop, result = GLib.MainLoop(), {}

def on_response(_conn, _sender, _path, _iface, _signal, params, _data):
    code, results = params.unpack()
    result["code"], result["uri"] = code, results.get("uri")
    loop.quit()

bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request",
                     "Response", path, None, Gio.DBusSignalFlags.NONE, on_response, None)
bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
              "org.freedesktop.portal.Screenshot", "Screenshot",
              GLib.Variant("(sa{sv})", ("", {"handle_token": GLib.Variant("s", token),
                                             "interactive": GLib.Variant("b", True)})),
              None, Gio.DBusCallFlags.NONE, -1, None)
GLib.timeout_add_seconds(120, loop.quit)
loop.run()
if result.get("code") != 0 or not result.get("uri"):
    sys.exit(1)
print(GLib.filename_from_uri(result["uri"])[0])
PY
}

ocr() {
    local mode=$1 img text
    command -v tesseract >/dev/null || { notify "Install OCR: sudo apt install tesseract-ocr"; return 1; }

    img=$(portal_screenshot) || return 0   # cancelled
    text=$(tesseract "$img" - -l "$OCR_LANGS" --tessdata-dir "$TESSDATA" 2>/dev/null \
        | sed -e 's/[[:space:]]\+$//' | awk 'NF{printf "%s%s", sep, $0; sep=" "; next} {sep="\n"}')
    rm -f -- "$img"

    if [ -z "$text" ]; then
        notify "No text found in the selected area."
        return 0
    fi

    if [ "$mode" = recognize ]; then
        # xclip (XWayland) instead of wl-copy: on GNOME wl-copy flashes a focus window.
        printf '%s' "$text" | xclip -selection clipboard
        notify "Recognized text copied to clipboard."
    else
        ensure_crow || return 1
        printf '%s' "$text" | xclip -selection primary
        sleep 0.2   # let mutter bridge the X primary selection to Wayland before Crow reads it
        call translateSelection && raise_crow
    fi
}

case "${1:-}" in
    start)             ensure_crow ;;
    translate)         ensure_crow && call translateSelection && raise_crow ;;
    speak)             ensure_crow && call speakSelection ;;
    speak-translation) ensure_crow && call speakTranslatedSelection ;;
    stop)              ensure_crow && call stopSpeaking ;;
    show)              ensure_crow && call open && raise_crow ;;
    ocr-translate)     ocr translate ;;
    ocr-recognize)     ocr recognize ;;
    *) echo "Usage: ${0##*/} start|translate|speak|speak-translation|stop|show|ocr-translate|ocr-recognize" >&2; exit 2 ;;
esac
